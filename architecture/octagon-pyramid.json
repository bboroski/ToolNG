  "methods": [
    {
      "index": 1,
      "id": "ANALYSIS",
      "description": "Inspect repository structure, interfaces, dependencies, tests and runtime behavior."
    },
    {
      "index": 2,
      "id": "DECOMPOSITION",
      "description": "Split cross-project goals into bounded, independently reviewable tasks."
    },
    {
      "index": 3,
      "id": "SYNTHESIS",
      "description": "Combine compatible designs through versioned contracts; never copy code blindly."
    },
    {
      "index": 4,
      "id": "SYNCHRONIZATION",
      "description": "Exchange versioned events and dependency state without sharing mutable internals."
    },
    {
      "index": 5,
      "id": "ADAPTATION",
      "description": "Translate shared contracts into each repository's native language and conventions."
    },
    {
      "index": 6,
      "id": "VALIDATION",
      "description": "Verify schemas, security, tests, provenance and compatibility before promotion."
    },
    {
      "index": 7,
      "id": "OPTIMIZATION",
      "description": "Measure bottlenecks and improve only with reproducible evidence."
    },
    {
      "index": 8,
      "id": "EVOLUTION",
      "description": "Propose incremental improvements, guarded by review, tests and rollback."
    }
