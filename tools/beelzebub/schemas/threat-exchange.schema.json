{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beelzebub.protocol/schemas/threat-exchange-1.0.json",
  "title": "Beelzebub Threat Exchange Format",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "advisory_id",
    "created_at",
    "issuer",
    "subject",
    "severity",
    "confidence",
    "evidence",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "advisory_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "package",
            "file-hash",
            "behavior"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "value"
        ],
        "properties": {
          "kind": {
            "enum": [
              "cve",
              "hash",
              "rule",
              "behavior"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "affected": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ecosystem",
          "range"
        ],
        "properties": {
          "ecosystem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "range": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "mitigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "upgrade",
            "configuration",
            "investigate"
          ]
        },
        "reference": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },
    "signature": {
      "type": "string",
      "minLength": 16,
      "maxLength": 4096
    }
  }
}
