  "animations": [
    {
      "name": "fade-in",
      "class": "duck-animate-fade-in",
      "keyframes": "duck-fade-in",
      "duration_ms": 160,
      "easing": "ease-out",
      "iteration": "1",
      "purpose": "Reveal newly mounted content without spatial movement"
    },
    {
      "name": "rise-in",
      "class": "duck-animate-rise-in",
      "keyframes": "duck-rise-in",
      "duration_ms": 200,
      "easing": "cubic-bezier(0.2,0.8,0.2,1)",
      "iteration": "1",
      "purpose": "Enter a panel, card or contextual surface"
    },
    {
      "name": "scale-in",
      "class": "duck-animate-scale-in",
      "keyframes": "duck-scale-in",
      "duration_ms": 180,
      "easing": "cubic-bezier(0.16,1,0.3,1)",
      "iteration": "1",
      "purpose": "Open a compact popover or modal"
    },
    {
      "name": "slide-inline",
      "class": "duck-animate-slide-inline",
      "keyframes": "duck-slide-inline",
      "duration_ms": 200,
      "easing": "cubic-bezier(0.2,0.8,0.2,1)",
      "iteration": "1",
      "purpose": "Reveal a drawer or contextual panel from its origin"
    },
    {
      "name": "status-pulse",
      "class": "duck-animate-pulse",
      "keyframes": "duck-pulse",
      "duration_ms": 1100,
      "easing": "ease-in-out",
      "iteration": "infinite",
      "purpose": "Subtle live-status indicator only; never the only state cue"
    },
    {
      "name": "spinner",
      "class": "duck-animate-spin",
      "keyframes": "duck-spin",
      "duration_ms": 800,
      "easing": "linear",
      "iteration": "infinite",
      "purpose": "Indeterminate loading glyph"
    },
    {
      "name": "skeleton-shimmer",
      "class": "duck-animate-shimmer",
      "keyframes": "duck-shimmer",
      "duration_ms": 1400,
      "easing": "linear",
      "iteration": "infinite",
      "purpose": "Loading placeholder while content is unavailable"
    },
    {
      "name": "validation-shake",
