{
  "schema_version": "1.0.0",
  "system": "Nero Spider / Mallard",
  "scope": "Flat visual contract for repository tools, desktop shells, portals, diagnostics, CI status and future GUI surfaces.",
  "principles": [
    "absolute flat surfaces; no shadows, gradients, silhouettes or skeuomorphic depth",
    "Nero black and anthracite form the structural foundation",
    "Mallard green is reserved for successful, trusted and protected states",
    "red is reserved for critical security failures; color is always paired with text or shape",
    "geometry uses square corners, thin rules and precise vector strokes",
    "motion is short, causal, optional and disabled by reduced-motion preferences",
    "repository identity, public APIs, runtime boundaries and license ownership remain independent"
  ],
  "color": {
    "nero_void": "#050505",
    "anthracite": "#121212",
    "surface": "#171717",
    "surface_alt": "#0D0D0D",
    "divider": "#1F1F1F",
    "divider_strong": "#343434",
    "mallard_green": "#006442",
    "mallard_hover": "#087A53",
    "mallard_surface": "#08251B",
    "text": "#F4F4F4",
    "text_secondary": "#C8C8C8",
    "text_muted": "#929292",
    "disabled": "#666666",
    "critical": "#FF1E1E",
    "critical_surface": "#2A0909",
    "warning": "#F2C94C",
    "warning_surface": "#29220C",
    "info": "#58C7E8",
    "info_surface": "#0B2028",
    "focus": "#F4F4F4",
    "selection": "#16352A"
  },
  "semantic_color": {
    "success": "mallard_green",
    "trusted": "mallard_green",
    "protected": "mallard_green",
    "critical": "critical",
    "warning": "warning",
    "information": "info",
    "selected": "selection",
    "focus": "focus",
    "state_requires_label_or_icon": true
  },
  "geometry": {
    "corner_radius_px": 0,
    "border_width_px": 1,
    "focus_outline_width_px": 2,
    "grid_step_px": 24,
    "icon_stroke_px": 1.75,
    "control_min_height_px": 36,
    "touch_target_min_px": 44,
    "panel_divider": "1px solid #1F1F1F"
  },
  "typography": {
    "ui": [
      "Inter",
      "Segoe UI",
      "Roboto",
      "Arial",
      "sans-serif"
    ],
    "technical": [
      "JetBrains Mono",
      "Fira Code",
      "Cascadia Code",
      "Consolas",
      "monospace"
    ],
    "body_px": 14,
    "small_px": 12,
    "micro_px": 11,
    "line_height": 1.5,
    "tabular_numbers": true,
    "uppercase_micro_labels": true
  },
  "motion_ms": {
    "micro": 100,
    "standard": 160,
    "panel": 220,
    "ripple": 420,
    "log_entry": 180,
    "progress_cycle": 1200,
    "sync_cycle": 900,
    "spinner": 800,
    "reduced_motion": 0
  },
  "motion": {
    "easing": "cubic-bezier(0.2,0.8,0.2,1)",
    "allowed": [
      "opacity",
      "transform",
      "stroke-dashoffset"
    ],
    "avoid": [
      "layout-thrashing",
      "large-area-pulses",
      "rapid-glitch",
      "forced-parallax"
    ],
    "reduced_motion_media_query": "prefers-reduced-motion: reduce",
    "no_audio_by_default": true,
    "no_custom_cursor_by_default": true
  },
  "graphics": {
    "format": "SVG",
    "flat_fill_only": true,
    "gradients": false,
    "shadows": false,
    "silhouettes": false,
    "background_grid": {
      "color": "#1F1F1F",
      "opacity": 0.02,
      "step_px": 24
    },
    "duck_mark": "abstract geometric line glyph; not a filled silhouette",
    "anime_motifs": "abstract geometry and typographic marks only; no character likenesses"
  },
  "components": {
    "status_bar": {
      "height_px": 28,
      "background": "#121212",
      "border_bottom": "#1F1F1F"
    },
    "button": {
      "radius_px": 0,
      "min_height_px": 36,
      "primary_background": "#006442",
      "primary_text": "#F4F4F4"
    },
    "checkbox": {
      "shape": "square",
      "unchecked_border": "#343434",
      "checked_border": "#006442",
      "filled": false
    },
    "card": {
      "radius_px": 0,
      "background": "#121212",
      "border": "#1F1F1F",
      "shadow": "none"
    },
    "progress": {
      "track": "#1F1F1F",
      "fill": "#006442",
      "indeterminate_motion": true
    },
    "critical_frame": {
      "outline": "2px solid #FF1E1E",
      "pulse": false
    },
    "terminal": {
      "font": "technical",
      "background": "#050505",
      "foreground": "#F4F4F4",
      "line_reveal_ms": 180
    }
  },
  "interaction": {
    "ripple_click": true,
    "scroll_inertia": "subtle; never delay direct manipulation",
    "log_entries": "append without reordering; announce through accessible live region",
    "security_cursor": "retain native cursor; use explicit focus and warning marker",
    "destructive_actions": "confirm and provide audit event",
    "emergency_stop": "two-step confirmation, keyboard accessible, auditable and fail-safe"
  },
  "accessibility": {
    "normal_text_contrast_min": 4.5,
    "large_text_contrast_min": 3,
    "keyboard_navigation": true,
    "visible_focus": true,
    "zoom_support": true,
    "reduced_motion": true,
    "state_not_color_only": true,
    "screen_reader_status": true,
    "minimum_touch_target_px": 44
  },
  "documentation": {
    "screenshot_directory": "docs/screenshots/",
    "screenshot_claim": "runtime screenshot only when captured from a running build; SVG preview must be labeled concept",
    "live_status_section": "Live Security Status",
    "generated_files": "never overwrite hand-maintained documentation outside explicit markers",
    "status_source": "verified CI/check-run data; missing data must render UNKNOWN, never PASS"
  },
  "governance": {
    "canonical_tokens_repository": "Luci",
    "per_repository_overrides": "allowed only for semantic mapping, not base palette",
    "no_monolith": true,
    "preserve_repository_identity": true,
    "preserve_licenses": true,
    "no_claim_of_runtime_without_implementation": true
  }
}
