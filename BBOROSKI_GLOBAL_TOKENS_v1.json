{
  "schema": "bboroski.design-tokens/v1",
  "project": "ToolNG",
  "tag": "Windows Device Evidence Probe",
  "domain": "READ-ONLY DEVICE DIAGNOSTICS",
  "mode": "dark",
  "colors": {
    "canvas": "#0D0D0D",
    "surface": "#141414",
    "raised": "#1C1C1C",
    "edge": "#303030",
    "text": "#E6E6E6",
    "muted": "#999999",
    "accent": "#FFD600",
    "accentSecondary": "#00D6C2",
    "success": "#45D483",
    "warning": "#FFD600",
    "danger": "#FF5B62",
    "info": "#66BFFF"
  },
  "typography": {
    "ui": "Inter, Segoe UI, sans-serif",
    "mono": "JetBrains Mono, Consolas, monospace"
  },
  "layout": {
    "baseUnit": 8,
    "radius": 10,
    "contentMax": 1440,
    "sidebarWidth": 248,
    "scaleMin": 1,
    "scaleMax": 2
  },
  "accessibility": {
    "minimumContrastTarget": "WCAG AA",
    "focusVisible": true,
    "reducedMotion": true
  },
  "visual": {
    "motif": "probe",
    "grid": 8,
    "strokeWidth": 2,
    "animation": "subtle-and-state-driven",
    "sampleDataMustBeLabeled": true
  }
}